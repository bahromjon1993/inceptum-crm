# Django Sozlamalari
SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app,.koyeb.app

# Ma'lumotlar bazasi (DATABASE_URL bo'lsa u avtomatik ishlatiladi)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Agar alohida parametrlarda kiritilsa:
DB_NAME=inceptum_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS ruxsat etilgan domenlar (Frontend domeni)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

